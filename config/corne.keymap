#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&led_strip { chain-length = <27>; };

/ {
    behaviors {
        db_Tap_f_b_slash: db_Tap_f_b_slash {
            compatible = "zmk,behavior-tap-dance";
            label = "DB_TAP_F_B_SLASH";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp NON_US_BACKSLASH>;
        };

        long_press_template: long_press_template {
            compatible = "zmk,behavior-hold-tap";
            label = "LONG_PRESS_TEMPLATE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            flavor = "tap-preferred";
        };

        hrm_main_right: hrm_main_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_MAIN_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <13 0 28 29 38 37 36 27 26 24 25 12 1 2 3 4 5 17 16 15 14>;
        };

        hrm_main_left: hrm_main_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_MAIN_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 6 8 9 10 11 23 22 21 20 19 18 30 31 32 33 34 35 41 40 39>;
        };

        hrm_mod_left: hrm_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_MOD_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 6 8 9 10 11 23 22 21 20 19 18 30 31 32 33 34 35 41 40 39>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        hrm_mod_right: HMRModR {
            compatible = "zmk,behavior-hold-tap";
            label = "Home Row Mod TP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <13 0 28 29 38 37 36 27 26 24 25 12 1 2 3 4 5 17 16 15 14>;
            flavor = "tap-preferred";
            quick-tap-ms = <176>;
            require-prior-idle-ms = <150>;
        };

        dbtap_minus_add: dbtap_minus_add {
            compatible = "zmk,behavior-tap-dance";
            label = "DBTAP_MINUS_ADD";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PLUS>;
        };

        dbtap_reg_brackets: dbtap_reg_brackets {
            compatible = "zmk,behavior-tap-dance";
            label = "DBTAP_REG_BRACKETS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        dbtap_curley_brackets: dbtap_curley_brackets {
            compatible = "zmk,behavior-tap-dance";
            label = "DBTAP_CURLEY_BRACKETS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;
        };

        dbtap_sqr_brackets: dbtap_sqr_brackets {
            compatible = "zmk,behavior-tap-dance";
            label = "DBTAP_SQR_BRACKETS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        backspace_combo {
            bindings = <&kp END>;
            key-positions = <22 21>;
            layers = <0>;
            slow-release;
        };

        tab_combo {
            bindings = <&kp HOME>;
            key-positions = <13 14>;
            layers = <0>;
            slow-release;
        };

        home_combo {
            bindings = <&kp TAB>;
            key-positions = <16 15>;
            layers = <0>;
            slow-release;
        };

        end_combo {
            bindings = <&kp BACKSPACE>;
            key-positions = <19 20>;
            layers = <0>;
            slow-release;
        };

        layer_3_right {
            bindings = <&mo 3>;
            key-positions = <40 37>;
            layers = <0>;
            slow-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none  &kp Q                            &kp W                            &kp E                                &kp R                              &kp T        &kp Y    &kp U                               &kp I                                 &kp O                             &kp P                                &none
&none  &long_press_template LEFT_WIN A  &long_press_template LEFT_ALT S  &long_press_template LEFT_CONTROL D  &long_press_template LEFT_SHIFT F  &kp G        &kp H    &long_press_template RIGHT_SHIFT J  &long_press_template RIGHT_CONTROL K  &long_press_template RIGHT_ALT L  &long_press_template RIGHT_WIN SEMI  &none
&none  &kp Z                            &kp X                            &long_press_template LC(C) C         &long_press_template LC(V) V       &kp B        &kp N    &kp M                               &kp COMMA                             &kp DOT                           &db_Tap_f_b_slash                    &none
                                                                         &mo 2                                &mo 1                              &kp SPACE    &kp RET  &mo 1                               &mo 2
            >;
        };

        Sym_Num_Layer {
            display-name = "SYM";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp EXCL             &kp AT                  &kp HASH             &kp DLLR             &kp PRCNT            &none            &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none  &none
&none  &dbtap_reg_brackets  &dbtap_curley_brackets  &dbtap_sqr_brackets  &dbtap_reg_brackets  &kp PIPE             &none            &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &none  &none
&none  &kp ASTERISK         &dbtap_minus_add        &kp AMPERSAND        &kp CARET            &db_Tap_f_b_slash    &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none  &none
                                                    &kp LEFT_SHIFT       &none                &kp SPACE            &kp RET          &none            &kp RIGHT_SHIFT
            >;
        };

        Movement_Layer {
            bindings = <
&none  &none            &none           &mkp LCLK       &mkp RCLK     &none     &none   &kp HOME      &kp END         &none           &none            &none
&none  &mmv MOVE_RIGHT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &none     &none   &kp UP_ARROW  &kp DOWN_ARROW  &kp LEFT_ARROW  &kp RIGHT_ARROW  &none
&none  &msc SCRL_RIGHT  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &none     &none   &none         &none           &none           &none            &none
                                        &none           &trans        &trans    &trans  &trans        &none
            >;

            label = "MVT";
        };

        Misc_Layer {
            bindings = <
&none  &none         &none         &none       &none           &none        &none      &none   &none  &none  &none  &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_CLR  &bt BT_CLR_ALL  &none        &none      &none   &none  &none  &none  &none
&none  &none         &none         &none       &none           &soft_off    &soft_off  &none   &none  &none  &none  &none
                                   &none       &trans          &none        &none      &trans  &none
            >;

            label = "BLU";
        };
    };
};
